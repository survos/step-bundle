{# The deck as an article: the same Markdown as /slideshow/markdown/<code>, rendered. #}
{% extends '@SurvosStep/castor/_logger_layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block logger_body %}
<style>
  .step-article { max-width: 46rem; margin: 2rem auto 4rem; font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif; font-size: 1.2rem; line-height: 1.7; color: #242424; }
  .step-article h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 .4rem; font-weight: 800; letter-spacing: -.01em; }
  .step-article .step-article-subtitle { font-size: 1.3rem; color: #6b6b6b; margin: 0 0 .6rem; font-style: italic; }
  .step-article .step-article-byline { font-family: system-ui, sans-serif; font-size: .95rem; color: #6b6b6b; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e6e6e6; }
  .step-article h2 { font-size: 1.7rem; line-height: 1.3; margin: 3rem 0 1rem; font-weight: 700; }
  .step-article p, .step-article ul, .step-article ol { margin: 0 0 1.3rem; }
  .step-article li { margin-bottom: .4rem; }
  .step-article pre { background: #f6f8fa; border: 1px solid #e6e6e6; border-radius: 6px; padding: 1rem 1.1rem; overflow-x: auto; font-size: .88rem; line-height: 1.5; margin: 0 0 1.5rem; }
  .step-article pre code { background: none; padding: 0; font-size: inherit; }
  .step-article :not(pre) > code { background: #f1f1f1; border-radius: 4px; padding: .1em .35em; font-size: .88em; }
  .step-article img { display: block; max-width: 100%; height: auto; margin: 1.5rem auto; border: 1px solid #e6e6e6; border-radius: 6px; }
  .step-article details { margin: 0 0 1.5rem; font-family: system-ui, sans-serif; font-size: .95rem; }
  .step-article summary { cursor: pointer; color: #6b6b6b; }
  .step-article-tools { font-family: system-ui, sans-serif; font-size: .85rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e6e6e6; color: #6b6b6b; }
</style>

<article class="step-article" data-controller="article">
  <h1>{{ title }}</h1>
  {% if subtitle %}<p class="step-article-subtitle">{{ subtitle }}</p>{% endif %}
  <div class="step-article-byline">
    {% if author %}{{ author }} · {% endif %}{{ stepCount }} {{ stepCount == 1 ? 'step' : 'steps' }}
  </div>

  {{ html|raw }}

  <div class="step-article-tools">
    <a href="{{ path('survos_step_markdown', {code: code}) }}">Markdown</a> ·
    <a href="{{ path('survos_step_slideshow', {code: code}) }}">Slideshow</a> ·
    <a href="{{ path('survos_step_slides', {code: code}) }}">Overview</a>
  </div>
</article>
{% endblock %}
